{
  "name": "nexobar-pos",
  "version": "1.0.0",
  "description": "NexoBar · POS Inteligente para Bares con funcionamiento sin conexión",
  "main": "electron/main.js",
  "author": "NexoBar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "co.nexobar.pos",
    "productName": "NexoBar",
    "directories": { "output": "dist" },
    "files": ["electron/**", "index.html", "app.js", "storage.js", "modules.js", "sync.js", "theme.css", "styles.css", "design.css", "manifest.webmanifest", "build/icon.png", "logo.png"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexoBar",
      "deleteAppDataOnUninstall": false,
      "language": "3082"
    }
  }
}
