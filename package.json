{
  "name": "nexobar-pos",
  "version": "1.0.0",
  "description": "NexoBar · POS Inteligente para Bares con funcionamiento 100% offline y sincronización en la nube",
  "main": "main.js",
  "author": "NexoBar",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.nexobar.pos",
    "productName": "NexoBar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron/**",
      "index.html",
      "app.js",
      "storage.js",
      "modules.js",
      "sync.js",
      "import-products.js",
      "xlsx.full.min.js",
      "theme.css",
      "styles.css",
      "design.css",
      "manifest.webmanifest",
      "build/icon.png",
      "logo.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexoBar",
      "deleteAppDataOnUninstall": false,
      "language": "3082"
    }
  }
}
